# Скопируйте в .env и при необходимости поменяйте значения.

# --- Пути
MATERIALS_DIR=materials
DATA_DIR=data

# --- LLM (провайдер меняется здесь, код не трогаем)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# --- Эмбеддинги
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3

# --- Векторное хранилище: пустой CHROMA_HOST = встроенный режим (файлы в DATA_DIR/chroma)
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_COLLECTION=materials

# --- Чанкинг и поиск
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
# Сколько символов каждого фрагмента передаётся модели (меньше — быстрее первый токен)
CONTEXT_FRAGMENT_CHARS=650
RETRIEVAL_CANDIDATES=20
MMR_LAMBDA=0.7
# Вес лексической выдачи (BM25) при объединении с семантической (у семантической вес 1)
LEXICAL_WEIGHT=0.5
# Порог косинусной близости: ниже него агент отвечает «В материалах этого нет»
RELEVANCE_THRESHOLD=0.55
# Тесты: true — фрагменты материалов идут в промпт генерации, false — модель составляет предложения сама
# (поиск всё равно проверяет тему и даёт ссылку на теорию)
QUIZ_USE_FRAGMENTS=false

# --- Параметры генерации
# Температура: 0 — модель отвечает строго и одинаково, чем выше — тем свободнее и тем больше риск выдумок
LLM_TEMPERATURE=0.0
# Окно контекста. Промпт + ответ (QUIZ_MAX_TOKENS для тестов) проверяются до вызова: при нехватке
# фрагменты сокращаются, иначе понятная ошибка — без молчаливой обрезки.
LLM_NUM_CTX=4096
LLM_MAX_TOKENS=700
LLM_KEEP_ALIVE=30m
# Сколько секунд ждать ответа модели на один вызов
LLM_TIMEOUT=300
# Генерация тестов: сэмплинг (при T=0 Qwen на части тем пишет объяснения по-китайски и повторяет брак)
QUIZ_TEMPERATURE=0.7
QUIZ_TOP_P=0.8
QUIZ_TOP_K=20
QUIZ_REPEAT_PENALTY=1.05
QUIZ_MAX_TOKENS=1500
# Отладка: каждый вызов LLM в JSON-сценариях (запрос, сырой ответ, токены) пишется в DEBUG_LLM_DIR
DEBUG_LLM=false
DEBUG_LLM_DIR=data/llm_debug
# Для LLM_PROVIDER=openai (любой OpenAI-совместимый сервер: llama.cpp, vLLM, LM Studio)
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=not-needed

# --- Веб и авторизация
API_URL=http://localhost:8000
AUTH_ENABLED=true
ALLOW_REGISTRATION=true
# Если заданы, пользователь создаётся при старте API
ADMIN_USERNAME=
ADMIN_PASSWORD=
